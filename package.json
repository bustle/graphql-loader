{
  "name": "@bustle/graphql-loader",
  "version": "2.0.1",
  "description": "GraphQL Loader for Webpack and Rspack",
  "license": "MIT",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/bustle/graphql-loader",
  "repository": "bustle/graphql-loader",
  "keywords": [
    "webpack",
    "rspack",
    "loader",
    "graphql"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "format": "prettier '**/*.{js,ts,json,md}' --ignore-path .gitignore --write",
    "prepublishOnly": "npm test && npm run build"
  },
  "devDependencies": {
    "@rspack/core": "^2.0.4",
    "@types/jest": "^30.0.0",
    "@types/memory-fs": "^0.3.3",
    "@types/node": "^25.9.1",
    "graphql": "^16.14.0",
    "jest": "^30.4.2",
    "memory-fs": "^0.5.0",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3",
    "webpack": "^5.64.4"
  },
  "peerDependencies": {
    "@rspack/core": "^2",
    "graphql": "^15 || ^16 || ^17",
    "webpack": "^5"
  },
  "peerDependenciesMeta": {
    "@rspack/core": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.spec.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    }
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none"
  }
}
