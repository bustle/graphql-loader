{
  "compilerOptions": {
    "strict": true,
    "declaration": true,
    "noEmitOnError": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "module": "node16",
    "target": "es2019",
    "lib": ["dom", "es2022", "esnext.disposable"],
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"]
  },
  "include": ["src"]
}
